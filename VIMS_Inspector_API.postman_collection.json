{
	"info": {
		"_postman_id": "vims-inspector-api",
		"name": "VIMS Inspector Client API - Complete & Tested",
		"description": "All 15 Inspector Client endpoints - 100% working and tested",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "inspection_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication & Machine Setup",
			"item": [
				{
					"name": "1.1 Machine Verification",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mac_address\": \"00:1B:44:11:22:33\",\n    \"certificate_serial\": \"CERT-VIMS-001\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users/verify_machine/",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "verify_machine", ""]
						}
					},
					"response": []
				},
				{
					"name": "1.2 Machine Handshake",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"machineId\": \"M-001B44112233\",\n    \"macAddress\": \"00:1B:44:11:22:33\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users/machine_handshake/",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "machine_handshake", ""]
						}
					},
					"response": []
				},
				{
					"name": "1.3 Inspector Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"access_token\", jsonData.access);",
									"    console.log(\"Access token saved:\", jsonData.access);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"inspector001\",\n    \"password\": \"test123\",\n    \"machineId\": \"M-001B44112233\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users/login/",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "login", ""]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Inspection Workflow",
			"item": [
				{
					"name": "2.1 Create Inspection",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"inspection_id\", jsonData.inspection_id);",
									"    console.log(\"Inspection ID saved:\", jsonData.inspection_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"inspection_id\": \"VIMS-LV-2025-{{$timestamp}}\",\n    \"plate_number\": \"AA12345\",\n    \"chassis_number\": \"WBADT43452G123456\",\n    \"engine_number\": \"N47D20A12345\",\n    \"vehicle_type\": \"Passenger Car\",\n    \"vehicle_category\": \"LIGHT\",\n    \"brand_model\": \"Toyota Camry\",\n    \"fuel_type\": \"Petrol\",\n    \"kilometer_reading\": 125000,\n    \"licensed_capacity\": 5,\n    \"title_certificate\": \"TC-2024-001234\",\n    \"owner_name\": \"John Doe\",\n    \"center\": \"CTR-AA-001\",\n    \"form_id\": \"LV-FORM-2025\",\n    \"test_start_time\": \"{{$isoTimestamp}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/inspections/",
							"host": ["{{base_url}}"],
							"path": ["api", "inspections", ""]
						}
					},
					"response": []
				},
				{
					"name": "2.2 Submit Visual Checklist (30-Point)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"items\": [\n        {\n            \"item_number\": 1,\n            \"item_name_en\": \"Registration Plate Validity\",\n            \"item_name_am\": \"የሰሌዳ ቁጥር ትክክለኛነት\",\n            \"zone_id\": \"zone1\",\n            \"zone_name_en\": \"Identification & Documentation\",\n            \"points_possible\": 5,\n            \"status\": \"PASS\",\n            \"defect_type\": \"\",\n            \"is_critical\": false,\n            \"is_mandatory\": false\n        },\n        {\n            \"item_number\": 2,\n            \"item_name_en\": \"Chassis Number Match\",\n            \"item_name_am\": \"የቻሲስ ቁጥር ማዛመድ\",\n            \"zone_id\": \"zone1\",\n            \"zone_name_en\": \"Identification & Documentation\",\n            \"points_possible\": 5,\n            \"status\": \"PASS\",\n            \"defect_type\": \"\",\n            \"is_critical\": true,\n            \"is_mandatory\": false\n        }\n    ],\n    \"notes\": \"All items verified and passed\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/inspections/{{inspection_id}}/submit_visual_checklist/",
							"host": ["{{base_url}}"],
							"path": ["api", "inspections", "{{inspection_id}}", "submit_visual_checklist", ""]
						}
					},
					"response": []
				},
				{
					"name": "2.3 Submit Machine Tests (RYME)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tests\": [\n        {\n            \"machine_test_id\": \"MT-{{inspection_id}}-1\",\n            \"test_type\": \"alignment\",\n            \"test_name\": \"Wheel Alignment & Suspension\",\n            \"test_data\": {\n                \"alignment_deviation\": 2.5,\n                \"suspension_left\": 55.2,\n                \"suspension_right\": 58.1,\n                \"suspension_diff\": 2.9\n            },\n            \"result\": \"PASS\",\n            \"pass_status\": true,\n            \"data_source\": \"RYME_SMRW\",\n            \"machine_serial\": \"RYME-AL-001\"\n        },\n        {\n            \"machine_test_id\": \"MT-{{inspection_id}}-2\",\n            \"test_type\": \"service_brake\",\n            \"test_name\": \"Service Brake Test\",\n            \"test_data\": {\n                \"front_left\": 2850.5,\n                \"front_right\": 2920.3,\n                \"rear_left\": 3100.2,\n                \"rear_right\": 3050.8,\n                \"total_force\": 11921.8\n            },\n            \"result\": \"PASS\",\n            \"pass_status\": true,\n            \"data_source\": \"RYME_SMRW\",\n            \"machine_serial\": \"RYME-BR-002\"\n        },\n        {\n            \"machine_test_id\": \"MT-{{inspection_id}}-3\",\n            \"test_type\": \"gas_analyzer\",\n            \"test_name\": \"Gas Analyzer Test\",\n            \"test_data\": {\n                \"co_percentage\": 0.15,\n                \"hc_ppm\": 85,\n                \"lambda\": 1.02\n            },\n            \"result\": \"PASS\",\n            \"pass_status\": true,\n            \"data_source\": \"RYME_SMRW\",\n            \"machine_serial\": \"RYME-GA-003\"\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/inspections/{{inspection_id}}/submit_machine_tests/",
							"host": ["{{base_url}}"],
							"path": ["api", "inspections", "{{inspection_id}}", "submit_machine_tests", ""]
						}
					},
					"response": []
				},
				{
					"name": "2.4 Upload GPS-Stamped Photo",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"photo_id\": \"PHOTO-{{inspection_id}}-001\",\n    \"purpose\": \"registration\",\n    \"photo_url\": \"https://vims-photos.s3.amazonaws.com/2025/01/{{inspection_id}}-001.jpg\",\n    \"latitude\": 9.012345,\n    \"longitude\": 38.765432,\n    \"gps_accuracy\": 10.5,\n    \"timestamp\": \"{{$isoTimestamp}}\",\n    \"file_size\": 1024000\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/inspections/{{inspection_id}}/upload_photo/",
							"host": ["{{base_url}}"],
							"path": ["api", "inspections", "{{inspection_id}}", "upload_photo", ""]
						}
					},
					"response": []
				},
				{
					"name": "2.5 Validate Geofence",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/inspections/{{inspection_id}}/validate_geofence/?lat=9.012345&lng=38.765432",
							"host": ["{{base_url}}"],
							"path": ["api", "inspections", "{{inspection_id}}", "validate_geofence", ""],
							"query": [
								{
									"key": "lat",
									"value": "9.012345"
								},
								{
									"key": "lng",
									"value": "38.765432"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "2.6 Update Sync Status",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"sync_status\": \"synced\",\n    \"sync_error\": \"\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/inspections/{{inspection_id}}/sync-status/",
							"host": ["{{base_url}}"],
							"path": ["api", "inspections", "{{inspection_id}}", "sync-status", ""]
						}
					},
					"response": []
				},
				{
					"name": "2.7 Process Payment & Finalize",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 250.00,\n    \"payment_method\": \"cash\",\n    \"transaction_id\": \"TXN-{{$timestamp}}\",\n    \"reference\": \"CASH-REF-001\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/inspections/{{inspection_id}}/process-payment/",
							"host": ["{{base_url}}"],
							"path": ["api", "inspections", "{{inspection_id}}", "process-payment", ""]
						}
					},
					"response": []
				}
			]
		},
